# Optional, public identifier shown in the app footer. Never put a token here.
NEXT_PUBLIC_BUILD_SHA=local

# Server-only credentials from the workshop Redis resource.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Use your own local namespace; Production and Preview have separate prefixes.
CHAT_ROOM_PREFIX=teamchat:local:your-name
